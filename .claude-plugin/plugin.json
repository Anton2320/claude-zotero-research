{
  "name": "sci-zotero-research",
  "version": "0.5.1",
  "description": "Research with your local Zotero library: find and download papers, read and transcribe PDFs to Markdown, and keep notes and tags in Zotero.",
  "keywords": [
    "zotero",
    "research",
    "papers",
    "pdf",
    "markdown"
  ],
  "license": "MIT",
  "mcpServers": {
    "sci-zotero-research": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/server/research_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  }
}
